[
    {
        "id": "simple-present",
        "tense": "Simple Present Tense",
        "group": "present",
        "rule": "is/am/are + V3 (Past Participle)",
        "active": {
            "structure": "Subject + V1/V1+s/es + Object",
            "example": "She reads the book."
        },
        "passive": {
            "structure": "Object + is/am/are + V3 + (by + Subject)",
            "example": "The book is read by her."
        },
        "note": "Use 'is' for singular, 'are' for plural, 'am' for I."
    },
    {
        "id": "present-continuous",
        "tense": "Present Continuous Tense",
        "group": "present",
        "rule": "is/am/are + being + V3",
        "active": {
            "structure": "Subject + is/am/are + V1+ing + Object",
            "example": "She is reading the book."
        },
        "passive": {
            "structure": "Object + is/am/are + being + V3 + (by + Subject)",
            "example": "The book is being read by her."
        },
        "note": null
    },
    {
        "id": "present-perfect",
        "tense": "Present Perfect Tense",
        "group": "present",
        "rule": "has/have + been + V3",
        "active": {
            "structure": "Subject + has/have + V3 + Object",
            "example": "She has read the book."
        },
        "passive": {
            "structure": "Object + has/have + been + V3 + (by + Subject)",
            "example": "The book has been read by her."
        },
        "note": "Use 'has been' for singular, 'have been' for plural subjects."
    },
    {
        "id": "present-perfect-continuous",
        "tense": "Present Perfect Continuous Tense",
        "group": "present",
        "rule": "Not commonly used in passive voice.",
        "active": {
            "structure": "Subject + has/have + been + V1+ing + Object",
            "example": "She has been reading the book for two hours."
        },
        "passive": {
            "structure": "Rarely converted to passive.",
            "example": "The book has been being read by her. (Avoid)"
        },
        "note": "Present Perfect Continuous is generally not converted to passive in standard usage."
    },
